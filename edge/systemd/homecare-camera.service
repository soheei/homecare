[Unit]
Description=HomeCare edge - camera (Camera Module V3) vision pipeline: YOLO events + heartbeat + current-frame capture
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alarmi
WorkingDirectory=/home/alarmi/homecare
ExecStart=/home/alarmi/homecare/.venv/bin/python -m vision.vision_pipeline
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
