{
  "info": {
    "name": "HomeCare Backend - 4단계 검증",
    "description": "백엔드 검증 4단계 프로토콜 전용 Postman 컬렉션",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "DEVICE_ID",
      "value": "22222222-2222-2222-2222-222222222222",
      "type": "string",
      "description": "현관 카메라 UUID (schema.sql 샘플 데이터)"
    },
    {
      "key": "DEVICE_SECRET",
      "value": "homecare-secret-change-this-in-production",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "✅ 1단계 - Health Check",
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/health",
        "description": "서버 정상 실행 확인 → 200 OK"
      }
    },
    {
      "name": "✅ 2단계 - API 루트 확인",
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/api"
      }
    },
    {
      "name": "📡 3단계 - 이벤트 생성 (가짜 라즈베리파이)",
      "item": [
        {
          "name": "방문자 감지 이벤트",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/events",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Id", "value": "{{DEVICE_ID}}" },
              { "key": "X-Device-Secret", "value": "{{DEVICE_SECRET}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"visitor\",\n  \"description\": \"현관 앞 방문자 감지 - 택배 기사 추정\",\n  \"dangerLevel\": \"normal\",\n  \"metadata\": {\n    \"confidence\": 0.92,\n    \"camera\": \"현관\"\n  }\n}"
            }
          }
        },
        {
          "name": "움직임 감지 이벤트",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/events",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Id", "value": "11111111-1111-1111-1111-111111111111" },
              { "key": "X-Device-Secret", "value": "{{DEVICE_SECRET}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"motion\",\n  \"description\": \"거실에서 움직임 감지\",\n  \"dangerLevel\": \"normal\",\n  \"metadata\": {\n    \"confidence\": 0.85,\n    \"camera\": \"거실\"\n  }\n}"
            }
          }
        },
        {
          "name": "⚠️ 위험 이벤트 (danger)",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/events",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Id", "value": "{{DEVICE_ID}}" },
              { "key": "X-Device-Secret", "value": "{{DEVICE_SECRET}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"danger\",\n  \"description\": \"낙상 의심 감지 - 거실\",\n  \"dangerLevel\": \"danger\",\n  \"metadata\": {\n    \"confidence\": 0.78,\n    \"camera\": \"거실\"\n  }\n}"
            }
          }
        },
        {
          "name": "❌ 오류 케이스 - 필수 필드 누락",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/events",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Id", "value": "{{DEVICE_ID}}" },
              { "key": "X-Device-Secret", "value": "{{DEVICE_SECRET}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"motion\"\n}"
            },
            "description": "description 없음 → 400 Bad Request"
          }
        },
        {
          "name": "❌ 오류 케이스 - 잘못된 type",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/events",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Device-Id", "value": "{{DEVICE_ID}}" },
              { "key": "X-Device-Secret", "value": "{{DEVICE_SECRET}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"invalid_type\",\n  \"description\": \"테스트\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "📋 4단계 - 이벤트 조회 (DB 교차 검증)",
      "item": [
        {
          "name": "이벤트 전체 목록",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/events",
            "header": [
              { "key": "Authorization", "value": "Bearer dev-token" }
            ]
          }
        },
        {
          "name": "오늘 일별 요약",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{BASE_URL}}/api/events/summary/daily?date=2026-05-03",
              "query": [{ "key": "date", "value": "2026-05-03" }]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer dev-token" }
            ]
          }
        },
        {
          "name": "주간 요약",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/events/summary/weekly",
            "header": [
              { "key": "Authorization", "value": "Bearer dev-token" }
            ]
          }
        }
      ]
    },
    {
      "name": "💬 Claude 채팅 테스트",
      "item": [
        {
          "name": "오늘 방문자 질문",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/chat/message",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer dev-token" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"오늘 방문자가 있었어?\"\n}"
            }
          }
        },
        {
          "name": "이어서 대화 (멀티턴)",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/chat/message",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer dev-token" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"위험한 상황은 없었어?\",\n  \"conversationId\": \"위_응답에서_받은_conversationId_입력\"\n}"
            }
          }
        },
        {
          "name": "하루 요약 리포트",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/chat/summary",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer dev-token" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"date\": \"2026-05-03\"\n}"
            }
          }
        }
      ]
    }
  ]
}
